# =====================================================================
# Stadion por HTTPS en la VM (AlmaLinux 8.10, Apache con mod_ssl)
# ---------------------------------------------------------------------
# Lo copia scripts/seguridad-servidor.sh (opcion 10, "Certificado SSL")
# a /etc/httpd/conf.d/stadion-ssl.conf, cambiando RAIZ_DEL_PROYECTO
# (por ejemplo /var/www/stadion) y NOMBRE_DEL_SITIO (stadion.local).
# Es el mismo sitio del puerto 80 (docs/configuracion-apache.md), en el
# 443 y cifrado.
#
# El certificado es propio (la VM no tiene un dominio publico): el
# navegador avisa la primera vez.
# =====================================================================

<VirtualHost *:443>
    ServerName NOMBRE_DEL_SITIO
    DocumentRoot "RAIZ_DEL_PROYECTO/public"

    SSLEngine on
    SSLCertificateFile /etc/pki/tls/certs/stadion.crt
    SSLCertificateKeyFile /etc/pki/tls/private/stadion.key
    # Solo TLS 1.2 y 1.3: las versiones viejas tienen fallas conocidas.
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    <Directory "RAIZ_DEL_PROYECTO/public">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # Los controladores viven fuera de public/: el .htaccess no les llega,
    # asi que las cabeceras de seguridad van aca (las mismas que manda
    # public/.htaccess).
    Alias /apps/controllers "RAIZ_DEL_PROYECTO/apps/controllers"
    <Directory "RAIZ_DEL_PROYECTO/apps/controllers">
        Options -Indexes
        AllowOverride None
        Require all granted
        <IfModule mod_headers.c>
            Header always set X-Content-Type-Options "nosniff"
            Header always set X-Frame-Options "DENY"
            Header always set Referrer-Policy "strict-origin-when-cross-origin"
            Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
            Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
            Header always set Strict-Transport-Security "max-age=31536000"
        </IfModule>
    </Directory>

    Alias /public "RAIZ_DEL_PROYECTO/public"

    ErrorLog logs/stadion-ssl-error.log
    CustomLog logs/stadion-ssl-access.log combined
</VirtualHost>
