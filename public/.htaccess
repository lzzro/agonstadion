# =====================================================================
# Paginas publicas - Stadion (Agon) - Lucas Martiarena
# ---------------------------------------------------------------------
# Las paginas pasaron de .html a .php en la segunda entrega, porque la
# cabecera depende de la sesion (ver apps/config/pagina.php).
# =====================================================================

# La portada es index.php. En la maquina local el virtual host decia
# index.html; esta linea lo corrige sin tener que tocarlo.
DirectoryIndex index.php

# Sin listado de carpetas. Pedir una carpeta que no tiene index.php
# (controllers/, css/, img/, js/) mostraba la lista de sus archivos,
# porque el hosting trae el listado prendido, igual que el virtual host
# de XAMPP. Esta linea vale para esta carpeta y todas las de adentro:
# ahora esas direcciones responden 403. subidas/ la repite en su propio
# .htaccess.
# Si el hosting no admitiera "Options" en un .htaccess, todo el sitio
# daria error 500: ver "Si algo falla" en docs/deploy-hosting-compartido.md.
Options -Indexes

# Quien tenga guardada una direccion vieja (torneos.html, login.html...)
# llega a la pagina nueva en vez de a un error. admin.html es ahora
# admin.php, que lleva a la administracion real, y panel.html es
# panel.php, que lleva al panel real del organizador.
RedirectMatch 301 "^(.*/)(index|torneos|torneo|calendario|llave|crear|login|registro|perfil|rendimiento|admin|panel)\.html$" "$1$2.php"
