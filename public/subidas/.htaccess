# Aca quedan las fotos de perfil y las portadas que sube la gente.

# 1. Sin listado de la carpeta.
Options -Indexes

# 2. Todo denegado, salvo exactamente los nombres que genera el sistema.
Require all denied
<FilesMatch "^[0-9a-f]{32}\.(jpg|png|webp)$">
    Require all granted
</FilesMatch>

# 3. PHP apagado en esta carpeta cuando corre como modulo de Apache (XAMPP).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# 4. Sin manejador que ejecute nada, se asocie PHP como se asocie.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh)$">
    SetHandler none
</FilesMatch>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
