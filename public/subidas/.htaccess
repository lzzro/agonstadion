# =====================================================================
# Carpeta de subidas - Stadion (Agon) - Lucas Martiarena
# ---------------------------------------------------------------------
# Aca quedan las fotos de perfil y las portadas que sube la gente. Es la
# unica carpeta del sitio donde escribe alguien de afuera, asi que no
# ejecuta nada y solo entrega imagenes con el nombre que genera el
# sistema (32 caracteres al azar y .jpg, .png o .webp).
#
# Son varias capas a proposito, porque no todos los servidores ejecutan
# PHP de la misma manera: XAMPP lo hace con el modulo de Apache, y
# otros servidores con PHP-FPM. Probado con Apache
# real en los dos casos, sacando capas de a una: la 2 y el SetHandler
# de la 4 frenan cada una por su cuenta en los dos servidores; la 3
# frena solo con el modulo de Apache. Si una fallara, quedan las otras.
# =====================================================================

# 1. Sin listado de la carpeta.
Options -Indexes

# 2. Todo denegado, salvo exactamente los nombres que genera el sistema.
#    Un "foto.php", un "shell.php.jpg" o un ".htaccess" nuevo no
#    coinciden y responden 403 antes de que nada los lea o los ejecute.
Require all denied
<FilesMatch "^[0-9a-f]{32}\.(jpg|png|webp)$">
    Require all granted
</FilesMatch>

# 3. PHP apagado en esta carpeta cuando corre como modulo de Apache
#    (XAMPP). Con PHP-FPM este bloque no aplica y se saltea solo,
#    sin error.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# 4. Sin manejador que ejecute nada, se asocie PHP como se asocie.
#    SetHandler none le gana al "SetHandler" con que un servidor conecta
#    PHP-FPM (y tambien al del modulo de XAMPP): el archivo se entrega
#    como texto, sin correr. RemoveHandler y RemoveType son para los
#    servidores que asocian PHP por extension con AddHandler, que no es
#    el caso de ninguno de los dos probados, pero si el de otros
#    servidores.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh)$">
    SetHandler none
</FilesMatch>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps

# 5. Que el navegador tome cada archivo por lo que dice ser y no
#    adivine: una imagen no se interpreta nunca como pagina.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
