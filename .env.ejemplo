# =====================================================================
# Las claves de Stadion en Docker - ARCHIVO DE EJEMPLO
# ---------------------------------------------------------------------
# Copiar este archivo como .env (en la misma carpeta) y cambiar las dos
# claves por otras propias: solo letras y numeros, 12 o mas. El .env no
# va al repositorio (lo excluye el .gitignore).
#
# SGDM_ROOT_CLAVE  la de root de MariaDB, para administrar la base
# SGDM_APP_CLAVE   la de sgdm_app, la cuenta con la que entra el sitio
# =====================================================================

SGDM_ROOT_CLAVE=CambiarEstaClaveRoot
SGDM_APP_CLAVE=CambiarEstaClaveApp
